# Domains and TLS
MBAS_DOMAIN=mbas.example.com
MBAS_API_DOMAIN=api.mbas.example.com
ACME_EMAIL=admin@example.com

# Database
POSTGRES_DB=mbas
POSTGRES_USER=mbas
POSTGRES_PASSWORD=change-this-before-production
DATABASE_URL=postgresql://mbas:change-this-before-production@postgres:5432/mbas
REDIS_URL=redis://redis:6379/0

# API
MBAS_ENV=development
MBAS_LOG_LEVEL=INFO
MBAS_CORS_ORIGINS=http://localhost:3000
MBAS_MASTER_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Provider credentials — never commit real values
SARVAM_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://livekit.example.com
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

