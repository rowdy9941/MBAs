# Domains and TLS
MBAS_DOMAIN=mbas.example.com
MBAS_API_DOMAIN=api.mbas.example.com
ACME_EMAIL=admin@example.com

# Database
POSTGRES_DB=mbas
POSTGRES_USER=mbas
# Development-only value; generate a unique secret for every deployment.
POSTGRES_PASSWORD=local-development-only
DATABASE_URL=postgresql://mbas:local-development-only@postgres:5432/mbas
REDIS_URL=redis://redis:6379/0

# API
MBAS_ENV=development
MBAS_LOG_LEVEL=INFO
MBAS_CORS_ORIGINS=http://localhost:3000
# Reserved for a later phase. Leave empty in Phase 0; never commit a real key.
MBAS_MASTER_ENCRYPTION_KEY=

# Provider credentials — never commit real values
SARVAM_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://livekit.example.com
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
